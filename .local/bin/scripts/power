#!/usr/bin/env bash

case "$1" in
    -r|--reboot)
        reboot --no-wall
        ;;

    -s|--shutdown)
        poweroff --no-wall
        ;;

    -u|--suspend)
        suspend
        ;;

    -h|--hibernate)
        systemctl hibernate
        ;;

    -l|--lock)
        hyprlock
        ;;

    *)
        echo "Usage: power [-r|--reboot] [-s|--shutdown] [-u|--suspend] [-h|--hibernate] [-l|--lock]"
        exit 1
        ;;
esac
