/**
 * Main Rofi Configuration
 */

configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "APPS";
    display-run:                "RUN";
    display-filebrowser:        "FILES";
    display-window:             "WINDOW";
	drun-display-format:        "{name}";
	window-format:              "{w} · {c} · {t}";
    icon-theme:                 "Papirus";
}

@import "catppuccin-default"

/* --- Window --- */
window {
    width:            380px;
    padding:          0px;
    border:           1px;
    border-radius:    10px;
    border-color:     @border-color;
    background-color: @bg-color;
}

/* --- Main Box --- */
mainbox {
    padding:          12px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

/* --- Input Bar --- */
inputbar {
    padding:          8px 16px;
    spacing:          8px;
    border:           1px;
    border-radius:    10px;
    border-color:     @border-color;
    background-color: @mantle;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color:       @accent-color;
}

entry {
    placeholder:      "Search";
    placeholder-color: @overlay0;
    text-color:       @fg-color;
}

/* --- List View --- */
listview {
    margin:           12px 0 0;
    lines:            8;
    columns:          1;
    fixed-height:     true;
    cycle:            true;
    scrollbar:        false;
    layout:           vertical;
    spacing:          5px;
    background-color: transparent;
}

/* --- Elements --- */
element {
    padding:          8px 16px;
    spacing:          8px;
    border-radius:    9px;
}

element-icon {
    size:             1.2em;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
}

/* --- Message / Textbox --- */
message {
    margin:           12px 0 0;
    border-radius:    10px;
}

textbox {
    padding:          8px 24px;
    text-color:       @fg-color;
}
