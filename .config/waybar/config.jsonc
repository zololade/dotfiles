// -*- mode: jsonc -*-
{
    // ── Bar ───────────────────────────────────────────────────────────────
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 6,
    "margin": "8 12 0 12",
    "exclusive-zone": true,
    "autohide": true,

    // ── Includes ──────────────────────────────────────────────────────────
    "include": [
        "~/.config/waybar/modules/niri.jsonc",
        "~/.config/waybar/modules/system.jsonc",
        "~/.config/waybar/modules/audio.jsonc",
        "~/.config/waybar/modules/notifications.jsonc",
        "~/.config/waybar/modules/tray.jsonc",
        "~/.config/waybar/modules/power.jsonc",
        "~/.config/waybar/modules/misc.jsonc"
    ],

    // ── Layout ────────────────────────────────────────────────────────────
    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/weather",
        "group/system",
        "pulseaudio",
        "group/systray",
        "group/controls",
        "battery",
        "custom/powermenu"
    ]
}
