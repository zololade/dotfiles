layout {
    gaps 15
    center-focused-column "always"
    
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    
    default-column-width { proportion 0.5; }

    focus-ring {
        width 1
        active-color "#303446ff" 
        inactive-color "#24273a99"
    }

    border {
        off // Niri docs recommend using either border OR focus-ring, not both.
    }

    shadow {
        on
        softness 30
        spread 5
        color "#000000c0"
    }

     struts {
        left 100
         right 100
         top 0
         bottom 0
    }
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

prefer-no-csd

