input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
}

cursor {
    xcursor-theme "Catppuccin-Mocha-Mauve-Cursors"
    xcursor-size 20
    hide-when-typing
    hide-after-inactive-ms 1000
}
