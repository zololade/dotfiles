spawn-at-startup "bash" "-c" "dbus-update-activation-environment --systemd --all && sleep 2 && systemctl --user restart xdg-desktop-portal"

// UI and Layout
spawn-at-startup "swww-daemon"
spawn-at-startup "waybar"

// Specialized Scripts
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-sh-at-startup "$HOME/.local/bin/scripts/import-gsettings"
spawn-sh-at-startup "hypridle -c $HOME/.config/niri/hypridle.conf"