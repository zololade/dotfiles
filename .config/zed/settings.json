// Zed Settings — Optimised for TypeScript + Oxc Development
// Documentation: https://zed.dev/docs/configuring-zed

{
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 1. EDITOR BEHAVIOR
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  
  "vim_mode": true,

  "soft_wrap": "editor_width",
  "scroll_beyond_last_line": "off",
  "sticky_scroll": {
    "enabled": false
  },

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 2. TEXT RENDERING & TYPOGRAPHY
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "text_rendering_mode": "platform_default",
  "buffer_line_height": "comfortable",
  "buffer_font_family": "MonaspiceAr Nerd Font Propo",
  "buffer_font_size": 12.0,
  "buffer_font_weight": 300.0, // Normal (was 100 — too thin)

  "ui_font_family": "Comic Neue",
  "ui_font_size": 14.0,
  "agent_ui_font_size": 15.0,
  "ui_font_weight": 400.0, // Medium

  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 12.0,
    "font_weight": 400, // Normal (was 100)
    "cursor_shape": "underline",
    "toolbar": {
      "breadcrumbs": false
    }
  },

  "colorize_brackets": true,
  "cursor_blink": true,

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 3. INDENTATION & WHITESPACE
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "tab_size": 2,
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "background_coloring": "disabled",
    "line_width": 2,
    "active_line_width": 2
  },

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 4. GUTTER, SCROLLBAR & LINE NUMBERS
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "gutter": {
    "line_numbers": true
  },

  "scrollbar": {
    "show": "never",
    "diagnostics": "all"
  },

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 5. DIAGNOSTICS & INLAY HINTS
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "diagnostics": {
    "inline": {
      "enabled": true,
      "padding": 0
    },
    "button": true
  },

  "inlay_hints": {
    "enabled": true,
    "show_parameter_hints": true,
    "show_type_hints": false,
    "show_value_hints": true,
    "show_background": false
  },

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 6. COMPLETIONS & AUTO-IMPORT
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "completions": {
    "words": "enabled"
  },

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 7. FORMATTING & LINTING (OXC)
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "format_on_save": "on",
  "prettier": {
    "allowed": false // Prevent conflicts with oxfmt
  },
  "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }],

  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": { "enabled": "always" }
        },
        "javascript": {
          "updateImportsOnFileMove": { "enabled": "always" }
        }
      }
    }
  },

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 8. UI PANELS & LAYOUT
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": false
  },
  "bottom_dock_layout": "contained",

  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true
  },

  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false,
    "code_actions": true
  },

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 9. WINDOW & TITLE BAR
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "use_system_window_tabs": true,
  "window_decorations": "server",
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false
  },
  "cli_default_open_behavior": "existing_window",

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 10. SESSION & THEME
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "session": {
    "trust_all_worktrees": true
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Dark Hard",
    "dark": "One Dark"
  },
  "icon_theme": "Zed (Default)",

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 11. SHORTCUTS & TOOLS
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "which_key": {
    "enabled": true
  },

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 12. AI & PRIVACY
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "disable_ai": true, // Disables Zed's built-in AI assistant

  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  // 13. LANGUAGE SERVERS COVERRIDES
  // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  "language_servers": ["!typescript-language-server", "..."]
}
