[global]

monitor = 0
follow = keyboard

width = (200, 250)
origin = top-right
offset = (30, 30)

scale = 1

indicate_hidden = yes

shrink = no

transparency = 5

separator_height = 5
padding = 12
horizontal_padding = 8
frame_width = 0
frame_color = "#282c34"
separator_color = auto

sort = yes
idle_threshold = 120

font = JetBrainsMono Nerd Font Thin 9
line_height = 0
markup = full
format = "<b>%s</b>\n%b"
alignment = left
show_age_threshold = 60
word_wrap = yes
ignore_newline = no
stack_duplicates = true

hide_duplicate_count = false

show_indicators = yes

icon_position = right

min_icon_size = 25
max_icon_size = 40

enable_recursive_icon_lookup = true

icon_theme = WhiteSur-dark

sticky_history = no

history_length = 20

browser = firefox

always_run_script = true
title = Dunst

class = Dunst

mouse_left_click = do_action

corner_radius = 10

[experimental]
per_monitor_dpi = true


[urgency_low]
background = "#24283b"
foreground = "#abb2bf"
timeout = 7


[urgency_normal]
background = "#24283b"
foreground = "#abb2bf"
timeout = 7


[urgency_critical]
background = "#24283b"
foreground = "#abb2bf"
frame_color = "#e06c75"
timeout = 0

[Spotify]
appname = Spotify
new_icon = /usr/share/icons/hicolor/64x64/apps/spotify-client.png
timeout = 3
